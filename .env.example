# Hand Cricket environment example.
# This project needs NO secrets. Only public platform configuration.
# Copy to `.env` for local runs if needed (`.env` is git-ignored).
# Real credentials must NEVER be committed — configure them in the
# hosting provider's environment variable system instead.

# Public port configuration (set automatically by most hosts, e.g. Vercel/Render).
PORT=5000

# Browser origins allowed to call /api/* (comma-separated).
# Defaults cover the live site plus local dev servers; same-origin
# needs no CORS entry. Tighten or extend for your own domains.
# HC_CORS_ORIGINS=https://handcricketvas.vercel.app

# Idle session expiry, seconds (default 7200 = 2h).
# HC_SESSION_TTL_SECONDS=7200

# DANGER: deterministic computer_move override for local testing ONLY.
# Leave unset in production — clients must never dictate the AI's move.
# HC_ALLOW_MOVE_OVERRIDE=1

# Local debug server only. Leave unset/false in production.
# FLASK_DEBUG=1
